---
import { getLang, getDict } from "../../i18n";
import type { CategoryScore } from "../../lib/audit/score";

interface Props {
  seo: CategoryScore;
  social: CategoryScore;
  perfScore: number | null;
  /** True while PageSpeed is still being measured — the client script fills it in. */
  perfPending: boolean;
}
const { seo, social, perfScore, perfPending } = Astro.props;
const t = getDict(getLang(Astro)).audit.report;

const tone = (n: number | null) =>
  n === null
    ? "text-faint"
    : n >= 90
      ? "text-ink"
      : n >= 50
        ? "text-warn"
        : "text-danger";

const passedCount = (s: CategoryScore) =>
  t.passedCount.replace("{passed}", String(s.passed)).replace("{total}", String(s.total));
---

<div class="grid gap-4 sm:grid-cols-3" data-score-cards>
  <div class="board p-5">
    <p class="text-[12px] text-faint">{t.categories.seo}</p>
    <p class={`mt-2 text-4xl font-medium ${tone(seo.percent)}`}>{seo.percent}</p>
    <p class="mt-1 text-sm text-muted">{passedCount(seo)}</p>
  </div>

  <div class="board p-5">
    <p class="text-[12px] text-faint">{t.categories.social}</p>
    <p class={`mt-2 text-4xl font-medium ${tone(social.percent)}`}>{social.percent}</p>
    <p class="mt-1 text-sm text-muted">{passedCount(social)}</p>
  </div>

  <div class="board p-5">
    <p class="text-[12px] text-faint">{t.categories.perf}</p>
    <p class={`mt-2 text-4xl font-medium ${tone(perfScore)}`} data-perf-score>
      {perfPending ? "—" : (perfScore ?? "—")}
    </p>
    <p
      class="mt-1 text-sm text-muted"
      data-perf-note
      data-unavailable={t.vitalsUnavailableShort}
    >
      {
        perfPending
          ? t.measuring
          : perfScore === null
            ? t.vitalsUnavailableShort
            : "PageSpeed Insights"
      }
    </p>
  </div>
</div>
