---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, getDict } from "../../i18n";

// Records are swept 30 days after the audit, so a shared report link outlives
// its record. That link is the whole point of the tool being shareable; landing
// on an empty 404 would read as a broken product rather than an expired page.
const lang = getLang(Astro);
const t = getDict(lang).audit.report;
const auditPath = lang === "en" ? "audit" : "auditoria";
---

<main class="shell flex min-h-[60vh] flex-col items-start justify-center gap-6 py-20">
  <h1 class="text-3xl font-semibold text-ink">{t.expiredTitle}</h1>
  <p class="max-w-xl text-muted">{t.expiredBody}</p>
  <a
    href={getRelativeLocaleUrl(lang, auditPath)}
    data-cta="audit_report_expired"
    class="rounded-lg bg-accent px-6 py-3.5 font-semibold text-white shadow-lg shadow-accent/20 transition-transform hover:-translate-y-0.5"
  >
    {t.reAudit}
  </a>
</main>
