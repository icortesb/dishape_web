---
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import WhatsAppFab from "../WhatsAppFab.astro";
import SectionHeader from "../SectionHeader.astro";
import Board from "../Board.astro";
import UrlForm from "./UrlForm.astro";
import { getLang, getDict } from "../../i18n";
import { SITE } from "../../site";
import { registry } from "../../lib/audit/registry";

const lang = getLang(Astro);
const t = getDict(lang).audit;

// Counted, never typed: the eyebrow cannot drift from the catalog it describes.
const count = registry.length;

// Same expression Seo.astro uses for <link rel="canonical">, so the schema can
// never claim a different URL than the page declares for itself.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Both nodes describe this page and nothing else: the FAQ entries are the same
// array the section below renders, and the offer is the tool being free.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      // Not meta.title: that string is a SERP snippet with pipes in it, and a
      // schema name is the product's name.
      name: t.meta.appName,
      description: t.meta.description,
      url: canonical,
      inLanguage: lang,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Any",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      provider: { "@type": "Organization", name: SITE.name, url: SITE.url },
    },
    {
      "@type": "FAQPage",
      inLanguage: lang,
      mainEntity: t.faq.items.map(([question, answer]) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    },
  ],
};
---

<Navbar />
<main>
  <section id="top" class="shell pt-6">
    <div class="board relative overflow-hidden">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute right-[10%] -bottom-36 hidden h-72 w-72 rounded-full bg-cube-top md:block"
      >
      </div>
      <div class="relative flex flex-col items-start gap-6 p-6 sm:p-10 lg:p-14">
        <h1 class="reveal max-w-3xl text-[clamp(2rem,4.6vw,3.6rem)] leading-[1.05] font-medium tracking-[-0.04em] text-ink">
          {t.hero.title}
        </h1>
        <p class="reveal max-w-xl text-[15px] leading-relaxed text-muted">{t.hero.subtitle}</p>
        {/* Outside .reveal on purpose: the one element that converts must not
            depend on an animation, or on the bundle that drives it. */}
        <div class="mt-4 w-full max-w-2xl">
          <UrlForm />
        </div>
      </div>
    </div>
  </section>

  <Board class="mt-16">
    <div class="flex flex-col gap-12">
      <SectionHeader title={t.whatWeCheck.title}>
        <p class="text-[15px] text-muted">{t.whatWeCheck.eyebrow.replace("{count}", String(count))}</p>
      </SectionHeader>
      {/* The headings are h3, not h2: SectionHeader already emits the
          section's h2, and a page that reports heading hierarchy has to keep
          its own. */}
      <ul class="grid gap-x-10 md:grid-cols-3">
        {
          (["seo", "social", "perf"] as const).map((key) => (
            <li class="reveal flex flex-col gap-2 border-t border-line py-6">
              <h3 class="text-[17px] leading-snug font-medium tracking-[-0.015em] text-ink">{t.report.categories[key]}</h3>
              <p class="text-[14px] leading-relaxed text-muted">{t.whatWeCheck.cards[key]}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Board>

  <Board class="mt-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
      <h2 class="text-[clamp(1.75rem,3.2vw,2.5rem)] leading-[1.08] font-medium tracking-[-0.035em] text-ink">{t.faq.title}</h2>
      <div class="flex flex-col border-b border-line">
        {
          t.faq.items.map(([question, answer]) => (
            <details class="faq group border-t border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[16px] font-medium tracking-[-0.01em] text-ink">
                {question}
                <span aria-hidden="true" class="relative h-3 w-3 shrink-0">
                  <span class="absolute top-1/2 left-0 h-px w-3 bg-ink" />
                  <span class="absolute top-0 left-1/2 h-3 w-px bg-ink transition-transform duration-300 group-open:scale-y-0" />
                </span>
              </summary>
              <p class="max-w-2xl pb-6 text-[14px] leading-relaxed text-muted">{answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </Board>
</main>
<Footer />
<WhatsAppFab />

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
