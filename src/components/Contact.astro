---
import Board from "./Board.astro";
import SectionHeader from "./SectionHeader.astro";
import { Icon } from "astro-icon/components";
import { getLang, getDict } from "../i18n";
import { SITE, waLink } from "../site";

const lang = getLang(Astro);
const t = getDict(lang).contact;

const label = "mb-2 block text-[13px] text-muted";
const row =
  "group flex items-center justify-between gap-4 border-t border-line py-4 transition-colors";
---

<Board id="contacto" class="mt-16" inner="relative overflow-hidden p-6 sm:p-10 lg:p-14">
  <div class="relative grid gap-14 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
    <div class="flex flex-col gap-10">
      <SectionHeader title={t.title} shape="half">
        <p class="text-[15px] leading-relaxed text-muted">{t.intro}</p>
      </SectionHeader>

      <form
        class="reveal grid gap-5"
        data-contact-form
        method="POST"
        action="/api/contact"
        data-lang={lang}
        data-sending={t.form.sending}
        data-success={t.form.success}
        data-error={t.form.error}
        data-audit-prefill={t.form.auditPrefill}
        data-report-base={lang === "en" ? "/en/audit/r/" : "/auditoria/r/"}
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class={label} for="name">{t.form.name}</label>
            <input class="field" id="name" name="name" type="text" placeholder={t.form.namePh} autocomplete="name" required />
          </div>
          <div>
            <label class={label} for="email">{t.form.email}</label>
            <input class="field" id="email" name="email" type="email" placeholder={t.form.emailPh} autocomplete="email" required />
          </div>
        </div>
        <div>
          <label class={label} for="company">{t.form.company}</label>
          <input class="field" id="company" name="company" type="text" placeholder={t.form.companyPh} autocomplete="organization" />
        </div>
        <div>
          <label class={label} for="message">{t.form.message}</label>
          <textarea class="field min-h-36 resize-y" id="message" name="message" placeholder={t.form.messagePh} required></textarea>
        </div>

        {/* Filled in by contact.ts when the visitor arrives from an audit
            report. Empty otherwise, and the API treats empty as absent. */}
        <input type="hidden" name="auditId" value="" />

        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute -left-[9999px] h-0 w-0 opacity-0"
        />

        <div class="flex flex-wrap items-center gap-5">
          <button type="submit" class="btn">{t.form.submit}</button>
          <p data-form-status role="status" aria-live="polite" class="hidden text-[13px]"></p>
        </div>
      </form>
    </div>

    <aside class="reveal flex flex-col gap-4 lg:pt-2">
      <h3 class="text-[17px] font-medium tracking-[-0.015em] text-ink">{t.asideTitle}</h3>
      <p class="text-[14px] leading-relaxed text-muted">{t.asideBody}</p>

      <div class="mt-4 flex flex-col border-b border-line">
        <a href={SITE.calendly} target="_blank" rel="noopener noreferrer" data-calendly class={row}>
          <span class="flex flex-col">
            <span class="text-[12px] text-faint">{t.calendlyLabel}</span>
            <span class="text-[15px] text-ink">{t.calendlyValue}</span>
          </span>
          <Icon name="lucide:arrow-up-right" class="h-4 w-4 text-faint transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-ink" />
        </a>
        <a href={waLink(t.whatsappPrefill)} target="_blank" rel="noopener noreferrer" data-wa-link class={row}>
          <span class="flex flex-col">
            <span class="text-[12px] text-faint">{t.whatsappLabel}</span>
            <span class="text-[15px] text-ink">{SITE.whatsappDisplay}</span>
          </span>
          <Icon name="lucide:arrow-up-right" class="h-4 w-4 text-faint transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-ink" />
        </a>
        <a href={`mailto:${SITE.email}`} class={row}>
          <span class="flex flex-col">
            <span class="text-[12px] text-faint">{t.emailLabel}</span>
            <span class="text-[15px] text-ink">{SITE.email}</span>
          </span>
          <Icon name="lucide:arrow-up-right" class="h-4 w-4 text-faint transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-ink" />
        </a>
      </div>

      <p class="flex items-center gap-2 text-[13px] text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        {t.responseTime}
      </p>
    </aside>
  </div>
</Board>

<script>
  import "../scripts/contact";
</script>
