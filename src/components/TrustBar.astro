---
import Board from "./Board.astro";
import { getLang, getDict } from "../i18n";
const t = getDict(getLang(Astro)).trust;
---

<Board class="mt-16" inner="relative overflow-hidden p-6 sm:p-10 lg:p-14">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-[8%] -bottom-24 hidden h-48 w-48 rounded-full bg-cube-left lg:block"
  >
  </div>
  <div class="relative grid gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-20">
    <ul class="flex flex-col">
      {
        t.metrics.map((m) => (
          <li class="reveal border-t border-line py-5 first:border-t-0 first:pt-0">
            <p class="text-[clamp(1.25rem,2.2vw,1.75rem)] leading-[1.2] font-medium tracking-[-0.025em] text-muted">
              <span
                class="text-ink tabular-nums"
                data-count={m.count}
                data-prefix={m.prefix}
                data-suffix={m.suffix}
              >
                {m.prefix}
                {m.count}
                {m.suffix}
              </span>{" "}
              {m.label}
            </p>
          </li>
        ))
      }
    </ul>
    <div class="reveal flex flex-col gap-5 lg:max-w-sm">
      <p class="text-[clamp(1.05rem,1.6vw,1.25rem)] leading-[1.45] tracking-[-0.01em] text-ink">{t.stance}</p>
      <span class="font-mono text-[11px] text-faint">{t.sources}</span>
    </div>
  </div>
</Board>
