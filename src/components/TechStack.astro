---
import Board from "./Board.astro";
import SectionHeader from "./SectionHeader.astro";
import { getLang, getDict } from "../i18n";

const t = getDict(getLang(Astro)).stack;
const groups = t.groups as readonly (readonly [string, readonly string[]])[];
---

<Board id="stack" class="mt-16" inner="relative overflow-hidden p-6 sm:p-10 lg:p-14">
  <div class="relative grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
    <SectionHeader title={t.title} shape="disc">
      <p class="text-[15px] leading-relaxed text-muted">{t.intro}</p>
    </SectionHeader>
    <dl class="flex flex-col">
      {
        groups.map(([name, items]) => (
          <div class="reveal grid gap-1 border-t border-line py-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="text-[13px] text-faint">{name}</dt>
            <dd class="text-[17px] leading-snug tracking-[-0.015em] text-ink">
              {items.join(", ")}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</Board>
