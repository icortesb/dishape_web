---
import Board from "./Board.astro";
import SectionHeader from "./SectionHeader.astro";
import ItemList from "./ItemList.astro";
import { getLang, getDict } from "../i18n";

const t = getDict(getLang(Astro)).ai;
---

<Board id="ia" class="mt-16" inner="relative overflow-hidden p-6 sm:p-10 lg:p-14">
  {/* One flat shape per artboard: a green disc half off the sheet. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-20 -right-20 h-36 w-36 rounded-full bg-cube-top sm:-top-40 sm:-right-32 sm:h-80 sm:w-80 lg:-top-44 lg:-right-20 lg:h-[24rem] lg:w-[24rem]"
  >
  </div>
  <div class="relative flex flex-col gap-12">
    <div class="pr-16 sm:pr-0">
    <SectionHeader title={t.title}>
        <p class="text-[15px] leading-relaxed text-muted">{t.intro}</p>
      </SectionHeader>
    </div>
    <ItemList items={t.items} />
  </div>
</Board>
