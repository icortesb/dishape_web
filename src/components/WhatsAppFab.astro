---
import { Icon } from "astro-icon/components";
import { getLang } from "../i18n";
import { waLink } from "../site";

const lang = getLang(Astro);
const label = lang === "en" ? "Chat on WhatsApp" : "Escribinos por WhatsApp";
const prefill =
  lang === "en"
    ? "Hi! I'd like to talk about a project."
    : "¡Hola! Me gustaría hablar sobre un proyecto.";
---

<a
  href={waLink(prefill)}
  target="_blank"
  rel="noopener noreferrer"
  data-wa-link
  data-cta="whatsapp_fab"
  aria-label={label}
  title={label}
  class="fixed right-4 bottom-4 z-40 inline-flex h-12 items-center gap-2 rounded-full bg-ink px-4 text-[14px] font-medium text-card transition-transform duration-300 ease-[var(--ease-out-expo)] active:scale-95 sm:right-6 sm:bottom-6"
>
  <Icon name="lucide:message-circle" class="h-5 w-5" />
  <span class="hidden sm:inline">WhatsApp</span>
</a>
