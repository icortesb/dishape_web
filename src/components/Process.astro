---
import Board from "./Board.astro";
import SectionHeader from "./SectionHeader.astro";
import { getLang, getDict } from "../i18n";

const t = getDict(getLang(Astro)).process;
---

<Board id="proceso" class="mt-16" inner="relative overflow-hidden p-6 sm:p-10 lg:p-14">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-10 right-10 hidden h-28 w-28 bg-cube-right sm:block lg:right-16 lg:h-36 lg:w-36"
  >
  </div>
  <div class="relative flex flex-col gap-14">
    <SectionHeader title={t.title}>
      <p class="text-[15px] leading-relaxed text-muted">{t.intro}</p>
    </SectionHeader>

    <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        t.steps.map(([n, title, body]) => (
          <li class="reveal flex flex-col gap-3">
            <div class="flex items-center gap-3">
              <span class="text-[2.75rem] leading-none font-medium tracking-[-0.05em] text-ink tabular-nums">
                {n}
              </span>
              <span aria-hidden="true" class="h-px flex-1 bg-line" />
            </div>
            <h3 class="mt-2 text-[17px] leading-snug font-medium tracking-[-0.015em] text-ink">{title}</h3>
            <p class="text-[14px] leading-relaxed text-muted">{body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Board>
