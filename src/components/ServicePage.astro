---
import Navbar from "./Navbar.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import WhatsAppFab from "./WhatsAppFab.astro";
import SectionHeader from "./SectionHeader.astro";
import Board from "./Board.astro";
import LogoMark from "./LogoMark.astro";
import ItemList from "./ItemList.astro";
import Statement from "./Statement.astro";
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang } from "../i18n";
import type { ServicePageData } from "../i18n";

interface Props {
  data: ServicePageData;
}
const { data } = Astro.props;
const lang = getLang(Astro);
const home = getRelativeLocaleUrl(lang, "");
---

<Navbar />
<main>
  <section id="top" class="shell pt-6">
    <a href={home} class="board-label inline-flex items-center gap-1 transition-colors hover:text-ink">
      <Icon name="lucide:arrow-left" class="h-3 w-3" />
      {data.back}
    </a>
    <div class="board relative overflow-hidden">
      <LogoMark
        class="pointer-events-none absolute -right-4 -bottom-10 h-40 w-40 sm:h-64 sm:w-64 lg:-right-2 lg:-bottom-16 lg:h-80 lg:w-80"
        decorative
      />
      <div class="relative flex flex-col items-start gap-8 p-6 pb-40 sm:p-10 sm:pb-60 lg:p-14 lg:pr-80">
        <h1 class="reveal max-w-3xl text-[clamp(2rem,4.6vw,3.6rem)] leading-[1.05] font-medium tracking-[-0.04em] text-ink">
          {data.h1}
        </h1>
        <p class="reveal max-w-xl text-[15px] leading-relaxed text-muted">{data.subtitle}</p>
        <div class="reveal flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href="#contacto" data-cta="service_hero_primary" class="btn">{data.ctaPrimary}</a>
          <a href={home} data-cta="service_hero_secondary" class="link text-[15px]">{data.ctaSecondary}</a>
        </div>
      </div>
    </div>
  </section>

  <Board class="mt-16">
    <div class="flex flex-col gap-12">
      <SectionHeader title={data.includes.title}>
        <p class="text-[15px] leading-relaxed text-muted">{data.includes.intro}</p>
      </SectionHeader>
      <ItemList items={data.includes.items} cols={3} />
    </div>
  </Board>

  <Board class="mt-16">
    <div class="flex flex-col gap-12">
      <SectionHeader title={data.why.title} shape="disc">
        <p class="text-[15px] leading-relaxed text-muted">{data.why.body}</p>
      </SectionHeader>
      <Statement items={data.why.points} at={0} size="sm" />
    </div>
  </Board>

  <Contact />
</main>
<Footer />
<WhatsAppFab />
