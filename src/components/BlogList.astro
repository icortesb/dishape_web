---
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import WhatsAppFab from "./WhatsAppFab.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, getDict } from "../i18n";
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"blog">[];
}
const { posts } = Astro.props;
const lang = getLang(Astro);
const t = getDict(lang).blog;
const dateLocale = lang === "es" ? "es-AR" : "en-US";
---

<Navbar />
<main>
  <section id="top" class="shell pt-6">
    <div class="board p-6 sm:p-10 lg:p-14">
      <h1 class="reveal max-w-3xl text-[clamp(2rem,4.6vw,3.6rem)] leading-[1.05] font-medium tracking-[-0.04em] text-ink">
        {t.title}
      </h1>
      <p class="reveal mt-6 max-w-xl text-[15px] leading-relaxed text-muted">{t.intro}</p>

      <ul class="mt-14 flex flex-col">
        {
          posts.map((post) => (
            <li class="reveal border-t border-line">
              <a
                href={getRelativeLocaleUrl(lang, `blog/${post.data.slug}`)}
                class="group grid gap-2 py-7 md:grid-cols-[10rem_1fr_auto] md:gap-8"
              >
                <span class="text-[13px] text-faint">
                  {(post.data.updatedDate ?? post.data.pubDate).toLocaleDateString(dateLocale, {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                    timeZone: "UTC",
                  })}
                </span>
                <span class="flex flex-col gap-2">
                  <h2 class="text-[clamp(1.2rem,2vw,1.5rem)] leading-snug font-medium tracking-[-0.025em] text-ink decoration-1 underline-offset-4 group-hover:underline">
                    {post.data.title}
                  </h2>
                  <p class="max-w-2xl text-[14px] leading-relaxed text-muted">{post.data.description}</p>
                </span>
                <span class="text-[13px] text-faint md:text-right">
                  {post.data.category} · {post.data.readingTime} {t.readingSuffix}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</main>
<Footer />
<WhatsAppFab />
