---
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import WhatsAppFab from "./WhatsAppFab.astro";
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, getDict } from "../i18n";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const lang = getLang(Astro);
const t = getDict(lang).blog;
const dateLocale = lang === "es" ? "es-AR" : "en-US";

const blogHome = getRelativeLocaleUrl(lang, "blog");
const contact = `${getRelativeLocaleUrl(lang, "")}#contacto`;
const related = getDict(lang).servicePages[post.data.relatedService];
const relatedUrl = getRelativeLocaleUrl(lang, related.slug);

// The revision date is the one that matters to the reader; fall back to the
// original when the article has never been revised.
const shownDate = post.data.updatedDate ?? post.data.pubDate;
const dateLabel = post.data.updatedDate ? t.updatedOn : t.postedOn;
---

<Navbar />
<main>
  <article id="top" class="shell pt-6">
    <a href={blogHome} class="board-label inline-flex items-center gap-1 transition-colors hover:text-ink">
      <Icon name="lucide:arrow-left" class="h-3 w-3" />
      {t.back}
    </a>
    <div class="board px-6 py-10 sm:px-10 sm:py-14 lg:py-20">
      <div class="mx-auto flex max-w-[42rem] flex-col gap-6">
        <p class="flex flex-wrap items-center gap-x-3 text-[13px] text-faint">
          <span class="text-ink">{post.data.category}</span>
          <span>{post.data.readingTime} {t.readingSuffix}</span>
          <span>
            {dateLabel}{" "}
            <time datetime={shownDate.toISOString()}>
              {shownDate.toLocaleDateString(dateLocale, {
                year: "numeric",
                month: "long",
                day: "numeric",
                // Frontmatter dates parse as midnight UTC: format them there too,
                // or a UTC-3 build renders every post a day early.
                timeZone: "UTC",
              })}
            </time>
          </span>
        </p>

        <h1 class="text-[clamp(1.9rem,4vw,3rem)] leading-[1.08] font-medium tracking-[-0.035em] text-ink">
          {post.data.title}
        </h1>
        <p class="text-[17px] leading-relaxed text-muted">{post.data.description}</p>

        <div class="article mt-6 border-t border-line pt-10">
          <slot />
        </div>

        <a
          href={relatedUrl}
          data-cta="blog_related_service"
          class="group mt-10 flex items-center justify-between gap-4 border-y border-line py-5"
        >
          <span class="flex flex-col gap-1">
            <span class="text-[12px] text-faint">{t.relatedTitle}</span>
            <span class="text-[17px] font-medium tracking-[-0.015em] text-ink">{related.navLabel}</span>
          </span>
          <Icon name="lucide:arrow-right" class="h-4 w-4 shrink-0 text-faint transition-transform group-hover:translate-x-1 group-hover:text-ink" />
        </a>
      </div>
    </div>
  </article>

  <section class="shell mt-16">
    <div class="board relative flex flex-col items-start gap-5 overflow-hidden p-6 sm:p-10 lg:p-14">
      <div aria-hidden="true" class="pointer-events-none absolute -top-28 -right-28 h-64 w-64 rounded-full bg-cube-top"></div>
      <h2 class="relative max-w-xl text-[clamp(1.6rem,3vw,2.25rem)] leading-[1.1] font-medium tracking-[-0.035em] text-ink">{t.ctaTitle}</h2>
      <p class="relative max-w-xl text-[15px] leading-relaxed text-muted">{t.ctaBody}</p>
      <a href={contact} data-cta="blog_cta" class="btn relative">{t.ctaButton}</a>
    </div>
  </section>
</main>
<Footer />
<WhatsAppFab />
