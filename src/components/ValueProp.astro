---
import Board from "./Board.astro";
import Statement from "./Statement.astro";
import { getLang, getDict } from "../i18n";

const t = getDict(getLang(Astro)).value;
---

<Board class="mt-16" inner="relative overflow-hidden p-6 sm:p-10 lg:p-14">
  {/* The statement runs across a large disc: type over shape. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-[6%] left-[28%] hidden h-[28rem] w-[28rem] rounded-full bg-cube-top md:block dark:bg-cube-right"
  >
  </div>
  <div class="relative flex flex-col gap-12">
    <h2 class="sr-only">{t.title}</h2>
    <Statement items={t.items} />
    <p class="reveal max-w-xl text-[15px] leading-relaxed text-muted">{t.intro}</p>
  </div>
</Board>
