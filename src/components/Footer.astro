---
import LogoMark from "./LogoMark.astro";
import Wordmark from "./Wordmark.astro";
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, getDict } from "../i18n";
import { SITE, waLink } from "../site";

const lang = getLang(Astro);
const nav = getDict(lang).nav;
const t = getDict(lang).footer;
const servicePages = getDict(lang).servicePages;
const home = getRelativeLocaleUrl(lang, "");

const links = [
  { label: nav.services, href: `${home}#servicios` },
  { label: nav.ai, href: `${home}#ia` },
  { label: nav.process, href: `${home}#proceso` },
  { label: nav.stack, href: `${home}#stack` },
  { label: nav.blog, href: getRelativeLocaleUrl(lang, "blog") },
  {
    label: nav.audit,
    // Slug differs per language; Spanish sits at the root (no /es/ tree).
    href: getRelativeLocaleUrl(lang, lang === "en" ? "audit" : "auditoria"),
  },
  { label: nav.contact, href: `${home}#contacto` },
];

const serviceLinks = Object.values(servicePages).map((p) => ({
  label: p.navLabel,
  href: getRelativeLocaleUrl(lang, p.slug),
}));

const social = [
  { icon: "github", href: SITE.social.github, label: "GitHub" },
  { icon: "linkedin", href: SITE.social.linkedin, label: "LinkedIn" },
  { icon: "message-circle", href: waLink(), label: "WhatsApp" },
  { icon: "mail", href: `mailto:${SITE.email}`, label: "Email" },
];

const year = new Date().getFullYear();
---

<footer class="mt-24">
  <div class="shell flex flex-col gap-12 pb-10">
    <div class="grid gap-10 border-t border-ink/10 pt-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="flex max-w-xs flex-col gap-3">
        <div class="flex items-center gap-2">
          <LogoMark class="h-6 w-6" />
          <Wordmark class="text-[17px]" />
        </div>
        <p class="text-[13px] leading-relaxed text-muted">{t.tagline}</p>
      </div>

      <nav class="flex flex-col gap-3" aria-label={t.sectionsTitle}>
        <span class="text-[13px] text-faint">{t.sectionsTitle}</span>
        <ul class="flex flex-col gap-2">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-[13px] text-ink transition-opacity hover:opacity-60">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="flex flex-col gap-3" aria-label={t.servicesTitle}>
        <span class="text-[13px] text-faint">{t.servicesTitle}</span>
        <ul class="flex flex-col gap-2">
          {
            serviceLinks.map((link) => (
              <li>
                <a href={link.href} class="text-[13px] text-ink transition-opacity hover:opacity-60">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-3">
        <span class="text-[13px] text-faint">{t.elsewhereTitle}</span>
        <ul class="flex flex-col gap-2">
          {
            social.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-[13px] text-ink transition-opacity hover:opacity-60"
                >
                  <Icon name={`lucide:${s.icon}`} class="h-3.5 w-3.5 text-faint" />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-col justify-between gap-2 text-[12px] text-faint sm:flex-row sm:items-center">
      <span>© {year} {SITE.name}. {t.rights}</span>
      <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-ink">{SITE.email}</a>
    </div>
  </div>
</footer>
