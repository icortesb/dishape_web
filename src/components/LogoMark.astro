---
/**
 * dishape mark: a lowercase "d" built from two flat shapes, a disc and a
 * rounded bar. The counter is a true hole (mask), so it works on any ground.
 */
interface Props {
  class?: string;
  /** Kept for older call sites; the counter is transparent now. */
  cut?: string;
  /** Hide from assistive tech when the mark is ornament. */
  decorative?: boolean;
}
const { class: className = "h-10 w-10", decorative = false } = Astro.props;
const uid = `d-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={decorative ? undefined : "img"}
  aria-label={decorative ? undefined : "dishape"}
  aria-hidden={decorative ? "true" : undefined}
>
  <mask id={uid}>
    <rect width="100" height="100" fill="#fff"></rect>
    <circle cx="40" cy="62" r="13" fill="#000"></circle>
  </mask>
  <g mask={`url(#${uid})`}>
    <circle cx="40" cy="62" r="32" style="fill: var(--color-cube-left)"></circle>
    <rect x="60" y="4" width="20" height="90" rx="10" style="fill: var(--color-cube-right)"></rect>
  </g>
</svg>
