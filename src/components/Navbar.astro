---
import LogoMark from "./LogoMark.astro";
import Wordmark from "./Wordmark.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, getDict, languages, type Lang } from "../i18n";
import { SITE } from "../site";

const lang = getLang(Astro);
const t = getDict(lang).nav;
const home = getRelativeLocaleUrl(lang, "");

// The audit landing is the tool's only organic entry point; unlinked from the
// site it depends entirely on search. The slug differs per language — there is
// no /es/ tree, so Spanish sits at the root.
const auditUrl = getRelativeLocaleUrl(lang, lang === "en" ? "audit" : "auditoria");

const links = [
  { label: t.services, href: `${home}#servicios` },
  { label: t.ai, href: `${home}#ia` },
  { label: t.process, href: `${home}#proceso` },
  { label: t.stack, href: `${home}#stack` },
  { label: t.blog, href: getRelativeLocaleUrl(lang, "blog") },
  { label: t.audit, href: auditUrl },
  { label: t.contact, href: `${home}#contacto` },
];

const other: Lang = lang === "es" ? "en" : "es";
const otherUrl = getRelativeLocaleUrl(other, "");
---

<header class="sticky top-0 z-50 bg-base/85 backdrop-blur-md">
  <nav class="shell flex h-16 items-center justify-between gap-6">
    <a href={home} class="flex items-center gap-2" aria-label="dishape — inicio">
      <LogoMark class="h-6 w-6" />
      <Wordmark class="text-[17px]" />
    </a>

    {/* lg, not md: below lg the seven labels collide with the wordmark and the
      booking button; the footer carries the full link set. */}
    <ul class="hidden items-center gap-7 lg:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-[13px] text-muted transition-colors hover:text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-4">
      <a
        href={otherUrl}
        hreflang={other}
        data-set-lang={other}
        class="text-[13px] text-muted transition-colors hover:text-ink"
        aria-label={`Switch to ${languages[other]}`}
      >
        {languages[other]}
      </a>
      <a
        href={SITE.calendly}
        target="_blank"
        rel="noopener noreferrer"
        data-calendly
        data-cta="navbar_book"
        class="btn btn-sm"
      >
        {t.book}
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  // Persist the chosen language the instant the toggle is clicked, BEFORE the
  // browser navigates. Otherwise the request for "/" still carries the old
  // lang cookie and the nginx edge redirect bounces the visitor back to their
  // previous language (EN->ES never reaches Spanish).
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest("[data-set-lang]");
    if (!a) return;
    var l = a.getAttribute("data-set-lang");
    document.cookie = "lang=" + l + "; path=/; max-age=31536000; samesite=lax";
  });
</script>
