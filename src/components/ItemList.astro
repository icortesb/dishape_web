---
/** Title + body pairs set as a ruled text grid. Icons are not drawn. */
interface Props {
  items: readonly (readonly [string, string, string])[];
  cols?: 2 | 3;
}
const { items, cols = 2 } = Astro.props;
---

<ul class:list={["grid gap-x-10", cols === 3 ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2"]}>
  {
    items.map(([, title, body]) => (
      <li class="reveal flex flex-col gap-2 border-t border-line py-6">
        <h3 class="text-[17px] leading-snug font-medium tracking-[-0.015em] text-ink">{title}</h3>
        <p class="text-[14px] leading-relaxed text-muted">{body}</p>
      </li>
    ))
  }
</ul>
