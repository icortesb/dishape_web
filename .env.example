# ── Email (contact form → Resend) ────────────────────────────────
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender on your domain (set up domain + DKIM in Resend first).
# Until the domain is verified you can use onboarding@resend.dev for testing.
CONTACT_FROM="dishape <no-reply@dishape.dev>"
# Where contact submissions are delivered.
CONTACT_TO=dishape.dev@gmail.com

# ── Analytics (all optional — left blank = tag simply not injected) ─
# Google Tag Manager container (manages GA4, Meta Pixel & Clarity inside GTM).
PUBLIC_GTM_ID=

# ── Site auditor (/auditoria) ────────────────────────────────────
# Where audit reports are stored as JSON. MUST live outside the release
# directory: the VPS deploy does `git reset --hard` on /opt/dishape.
AUDIT_DATA_DIR=/var/lib/dishape/audits
# Optional in code, but set it: without a key PageSpeed Insights bills against a
# shared anonymous project whose daily quota is usually already spent (measured
# 2026-08-16: 429 on the first keyless call), so the performance card just reads
# "no se pudo medir". Free key:
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ── Server (Node standalone build) ───────────────────────────────
HOST=0.0.0.0
PORT=4321
